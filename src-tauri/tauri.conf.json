{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agora",
  "version": "0.7.0",
  "identifier": "com.overturesys.agora",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agora",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:*" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Free, open-source app for Stream Dock devices",
    "copyright": "Copyright (c) 2026 overture-sys. MIT License."
  }
}
